{%- liquid
assign vids = section.blocks | where: 'type', 'video'
assign pv = 0
if section.settings.from_product and product
 assign pvs = product.media | where: 'media_type', 'video'
 assign pv = pvs.size
endif
assign show = false
if vids.size > 0 or pv > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<div class="el-videos" style="--ar:{{ section.settings.ratio }}">{%- if section.settings.from_product and product -%}{%- assign pvs = product.media | where: 'media_type', 'video' -%}{%- for m in pvs -%}<figure class="el-video" style="margin:0">{{ m | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '720x' }}</figure>{%- endfor -%}{%- endif -%}{%- for b in vids -%}{%- if b.settings.video != blank -%}<figure class="el-video" style="margin:0" {{ b.shopify_attributes }}>{{ b.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '720x' }}{%- if b.settings.caption != blank -%}<figcaption>{{ b.settings.caption | escape }}</figcaption>{%- endif -%}</figure>{%- endif -%}{%- endfor -%}</div>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Videos",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "checkbox",
   "id": "from_product",
   "label": "Incluir videos del producto",
   "default": true
  },
  {
   "type": "select",
   "id": "ratio",
   "label": "Proporción",
   "default": "9/16",
   "options": [
    {
     "value": "9/16",
     "label": "Vertical 9:16"
    },
    {
     "value": "4/5",
     "label": "4:5"
    },
    {
     "value": "1/1",
     "label": "Cuadrado"
    },
    {
     "value": "16/9",
     "label": "Horizontal 16:9"
    }
   ]
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "video",
   "name": "Video",
   "settings": [
    {
     "type": "video",
     "id": "video",
     "label": "Video"
    },
    {
     "type": "text",
     "id": "caption",
     "label": "Leyenda"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Videos"
  }
 ]
}
{% endschema %}
