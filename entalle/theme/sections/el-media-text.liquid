{%- liquid
assign show = false
if section.settings.image != blank or section.settings.video != blank or section.settings.text != blank
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}{%- liquid
 assign has_media = false
 if section.settings.image != blank or section.settings.video != blank
  assign has_media = true
 endif
-%}<div class="el-mt{% if section.settings.side == 'right' %} el-mt--right{% endif %}{% unless has_media %} el-mt--text{% endunless %}">{%- if has_media -%}<div class="el-mt__media">{%- if section.settings.video != blank -%}{{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', muted: true, image_size: '900x' }}{%- elsif section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '360,540,720,900,1200', sizes: '(min-width: 990px) 560px, 100vw', loading: 'lazy', alt: section.settings.alt }}{%- endif -%}</div>{%- endif -%}<div class="el-mt__body">{%- if section.settings.title != blank -%}<h2>{{ section.settings.title | escape }}</h2>{%- endif -%}<div class="el-rte">{{ section.settings.text }}</div>{%- if section.blocks.size > 0 -%}<ul class="el-bullets">{%- for b in section.blocks -%}<li {{ b.shopify_attributes }}>{{ b.settings.text }}</li>{%- endfor -%}</ul>{%- endif -%}</div></div>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Imagen o video con texto",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "select",
   "id": "side",
   "label": "Imagen a la",
   "default": "left",
   "options": [
    {
     "value": "left",
     "label": "Izquierda"
    },
    {
     "value": "right",
     "label": "Derecha"
    }
   ]
  },
  {
   "type": "image_picker",
   "id": "image",
   "label": "Imagen"
  },
  {
   "type": "text",
   "id": "alt",
   "label": "Texto alternativo"
  },
  {
   "type": "video",
   "id": "video",
   "label": "Video (reemplaza la imagen)"
  },
  {
   "type": "text",
   "id": "title",
   "label": "Título del bloque"
  },
  {
   "type": "richtext",
   "id": "text",
   "label": "Texto"
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "point",
   "name": "Viñeta",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Texto (acepta <b>)",
     "default": "✅ Punto"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Imagen o video con texto"
  }
 ]
}
{% endschema %}
