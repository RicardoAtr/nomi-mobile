{%- liquid
assign show = false
if section.blocks.size > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<ul class="el-included">{%- for b in section.blocks -%}<li {{ b.shopify_attributes }}><b>{%- if b.settings.per_pack -%}<span data-el-qty-mult="{{ b.settings.units | default: 1 }}">{{ b.settings.units | default: 1 }}</span>×{%- else -%}{{ b.settings.qty | escape }}{%- endif -%}</b><span>{{ b.settings.text | escape }}</span></li>{%- endfor -%}</ul>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Qué incluye",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "item",
   "name": "Artículo",
   "settings": [
    {
     "type": "text",
     "id": "qty",
     "label": "Cantidad",
     "default": "1×"
    },
    {
     "type": "checkbox",
     "id": "per_pack",
     "label": "Multiplicar por las unidades del pack elegido",
     "default": false
    },
    {
     "type": "number",
     "id": "units",
     "label": "Unidades por pack de 1",
     "default": 1
    },
    {
     "type": "text",
     "id": "text",
     "label": "Descripción",
     "default": "Artículo"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Qué incluye"
  }
 ]
}
{% endschema %}
