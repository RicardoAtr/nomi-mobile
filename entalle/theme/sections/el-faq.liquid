{%- liquid
assign show = false
if section.blocks.size > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<div class="el-faq el-acc">{%- for b in section.blocks -%}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q | escape }}</summary><div class="el-rte">{{ b.settings.a }}</div></details>{%- endfor -%}</div>{%- if section.settings.schema and request.page_type == 'product' -%}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for b in section.blocks -%}{"@type":"Question","name":{{ b.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.a | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>{%- endif -%}{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Preguntas frecuentes",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "checkbox",
   "id": "schema",
   "label": "Datos estructurados FAQ para Google",
   "default": true
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "q",
   "name": "Pregunta",
   "settings": [
    {
     "type": "text",
     "id": "q",
     "label": "Pregunta",
     "default": "Pregunta"
    },
    {
     "type": "richtext",
     "id": "a",
     "label": "Respuesta",
     "default": "<p>Respuesta</p>"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Preguntas frecuentes"
  }
 ]
}
{% endschema %}
