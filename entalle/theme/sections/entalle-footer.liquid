<footer class="wrap footer"><div><a class="brand" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 320 | image_tag: widths: '160,320', width: 160, loading: 'lazy', alt: settings.brand }}{% else %}{{ settings.brand | escape }}{% endif %}</a><p>{{ section.settings.tagline | escape }}</p>{% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{% endif %}{% if settings.whatsapp != blank %}<a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}</div><nav aria-label="{{ 'ui.footer_links' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}<a href="{{ routes.root_url }}">{{ 'ui.home' | t }}</a><a href="{{ routes.all_products_collection_url }}">{{ 'ui.shop' | t }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav><div>{% for block in section.blocks %}<a href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endfor %}{% if settings.payments %}<ul class="payment-icons" aria-label="{{ 'ui.payments' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}</div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ settings.brand | escape }}</span>{% if settings.legal_identity != blank %}<span>{{ settings.legal_identity | escape }}</span>{% endif %}</div></footer>
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"tagline","label":"Frase","default":"Haz espacio para lo que importa."},{"type":"link_list","id":"menu","label":"Menú de ayuda"}],"blocks":[{"type":"social","name":"Red social","settings":[{"type":"text","id":"label","label":"Nombre"},{"type":"url","id":"url","label":"Enlace"}]}]}
{% endschema %}
