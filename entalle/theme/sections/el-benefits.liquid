{%- liquid
assign show = false
if section.blocks.size > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<div class="el-grid" style="--cols-m:{{ section.settings.cols_m }};--cols-d:{{ section.settings.cols_d }}">{%- for b in section.blocks -%}<div class="el-card" {{ b.shopify_attributes }}>{%- if b.settings.image != blank -%}<div class="el-card__img">{{ b.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</div>{%- elsif b.settings.icon != blank -%}<div class="el-card__ico" aria-hidden="true">{{ b.settings.icon }}</div>{%- endif -%}<h3>{{ b.settings.title | escape }}</h3>{%- if b.settings.text != blank -%}<p>{{ b.settings.text | escape }}</p>{%- endif -%}</div>{%- endfor -%}</div>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Beneficios",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "select",
   "id": "cols_m",
   "label": "Columnas en móvil",
   "default": "2",
   "options": [
    {
     "value": "1",
     "label": "1"
    },
    {
     "value": "2",
     "label": "2"
    }
   ]
  },
  {
   "type": "range",
   "id": "cols_d",
   "label": "Columnas en PC",
   "min": 2,
   "max": 6,
   "step": 1,
   "default": 4
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "benefit",
   "name": "Beneficio",
   "settings": [
    {
     "type": "text",
     "id": "icon",
     "label": "Emoji o ícono",
     "default": "✅"
    },
    {
     "type": "image_picker",
     "id": "image",
     "label": "Imagen (reemplaza el emoji)"
    },
    {
     "type": "text",
     "id": "title",
     "label": "Título",
     "default": "Beneficio"
    },
    {
     "type": "textarea",
     "id": "text",
     "label": "Texto"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Beneficios",
   "blocks": [
    {
     "type": "benefit"
    },
    {
     "type": "benefit"
    },
    {
     "type": "benefit"
    },
    {
     "type": "benefit"
    }
   ]
  }
 ]
}
{% endschema %}
