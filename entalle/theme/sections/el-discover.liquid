{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['catalogo']
  endif
  assign items = col.products
  assign shown = 0
  for it in items
    if it.available and it.id != product.id
      assign shown = shown | plus: 1
    endif
  endfor
  assign col_list = section.settings.collections
-%}
{%- if shown > 0 or col_list.size > 0 -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% endif %}" id="el-{{ section.id }}">
  <div class="el-container el-rv">
    {%- render 'el-heading', s: section.settings -%}
    {%- if col_list.size > 0 -%}
    <div class="el-disc" style="--cols-d:{{ col_list.size | at_most: 4 }};margin-bottom:22px">
      {%- for c in col_list -%}
      <a class="el-disc__card" href="{{ c.url }}"><div class="el-disc__img">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 600 | image_tag: widths: '300,600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}{%- endif -%}</div><div class="el-disc__body"><h3>{{ c.title | escape }}</h3><span class="el-disc__cta">Ver categoría →</span></div></a>
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if shown > 0 -%}
    <div class="el-disc" style="--cols-d:{{ section.settings.cols_d }}">
      {%- assign c = 0 -%}
      {%- for it in items -%}
        {%- if it.available and it.id != product.id and c < section.settings.limit -%}
        {%- assign c = c | plus: 1 -%}
        <a class="el-disc__card" href="{{ it.url }}">
          <div class="el-disc__img">{%- if it.featured_image -%}{{ it.featured_image | image_url: width: 600 | image_tag: widths: '300,600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}{%- endif -%}{%- if section.settings.badge_tag != blank and it.tags contains section.settings.badge_tag -%}<span class="el-offer__badge">{{ section.settings.badge_tag | escape }}</span>{%- endif -%}</div>
          <div class="el-disc__body"><h3>{{ it.title | escape }}</h3><span class="el-disc__price">{% if it.price_varies %}Desde {% endif %}{% render 'entalle-money', amount: it.price %}{% if it.compare_at_price > it.price %}<s>{% render 'entalle-money', amount: it.compare_at_price %}</s>{% endif %}</span><span class="el-disc__cta">Ver producto →</span></div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.more_label != blank and col != blank -%}<div class="el-disc-more"><a class="el-btn el-btn--ghost" href="{{ col.url }}">{{ section.settings.more_label | escape }}</a></div>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Descubre más productos","settings":[
{"type":"select","id":"bg","label":"Fondo","default":"soft","options":[{"value":"white","label":"Blanco"},{"value":"soft","label":"Suave"}]},
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Catálogo Entalle"},
{"type":"text","id":"heading","label":"Título","default":"Descubre más productos"},
{"type":"textarea","id":"intro","label":"Bajada"},
{"type":"collection_list","id":"collections","label":"Categorías destacadas (opcional)","limit":8},
{"type":"collection","id":"collection","label":"Colección de productos (vacío = Catálogo)"},
{"type":"range","id":"limit","label":"Máximo de productos","min":2,"max":12,"step":1,"default":8},
{"type":"range","id":"cols_d","label":"Columnas en PC","min":2,"max":5,"step":1,"default":4},
{"type":"text","id":"badge_tag","label":"Etiqueta de producto que muestra sello"},
{"type":"text","id":"more_label","label":"Botón «ver todo»","default":"Ver todo el catálogo"},
{"type":"paragraph","content":"Solo muestra productos disponibles y omite el producto actual. Si no hay otros, la sección no aparece."}],
"presets":[{"name":"Descubre más productos"}]}
{% endschema %}
