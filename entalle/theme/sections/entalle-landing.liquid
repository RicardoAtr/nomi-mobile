{%- if request.page_type == 'product' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ p.title | json }},"description":{{ p.description | strip_html | strip_newlines | truncate: 300 | json }},"brand":{"@type":"Brand","name":{{ p.vendor | json }}},{% if v.sku != blank %}"sku":{{ v.sku | json }},{% endif %}{% if v.barcode != blank %}"gtin":{{ v.barcode | json }},{% endif %}"image":[{% for media in images limit: 4 %}{{ media | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],"url":{{ request.origin | append: p.url | json }},"offers":{"@type":"Offer","price":{{ v.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}","url":{{ request.origin | append: p.url | json }},"seller":{"@type":"Organization","name":{{ shop.name | json }}}}}</script>
{%- endif -%}

<script>
(function(){
  var root=document.currentScript.closest('[data-el]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
  var vid=root.dataset.vid,fmt=function(c){return new Intl.NumberFormat('es-CL',{style:'currency',currency:'CLP',maximumFractionDigits:0}).format(c/100)};
  var TZ='America/Santiago',DW=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'],MO=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'],FROM={{ section.settings.eta_from }},TO={{ section.settings.eta_to }};
  try{var o={};new Intl.DateTimeFormat('en-US',{timeZone:TZ,year:'numeric',month:'numeric',day:'numeric'}).formatToParts(new Date()).forEach(function(x){o[x.type]=+x.value});
    var dd=function(n){var d=new Date(Date.UTC(o.year,o.month-1,o.day+n));return DW[d.getUTCDay()]+' '+d.getUTCDate()+' '+MO[d.getUTCMonth()]};
    root.querySelectorAll('[data-eta]').forEach(function(el){el.innerHTML='<b>Llega entre el '+dd(FROM)+'</b> y el <b>'+dd(TO)+'</b>'})}catch(e){}
  var track=root.querySelector('[data-track]'),thumbs=root.querySelectorAll('[data-thumb]');
  thumbs.forEach(function(b){b.addEventListener('click',function(){track.scrollTo({left:track.clientWidth*(+b.dataset.thumb)})})});
  if(track)track.addEventListener('scroll',function(){var i=Math.round(track.scrollLeft/track.clientWidth);thumbs.forEach(function(b){b.setAttribute('aria-current',String(+b.dataset.thumb===i))})},{passive:true});
  var qty=root.querySelector('[data-qty]');
  function sync(){var r=root.querySelector('.el-packs input:checked');if(!r)return;var pp=+r.dataset.pp,pf=+r.dataset.pf,on=pf>pp;
    root.querySelector('[data-p]').textContent=fmt(pp);var sp=root.querySelector('[data-sp]');if(sp)sp.textContent=fmt(pp);
    var c=root.querySelector('[data-c]'),s=root.querySelector('[data-s]');c.hidden=!on;s.hidden=!on;if(on){c.textContent=fmt(pf);root.querySelector('[data-pct]').textContent=Math.round((pf-pp)*100/pf)}
    var sl=root.querySelector('[data-sl]');if(sl)sl.textContent=r.dataset.label+' · envío gratis';
    qty.value=r.value;root.querySelectorAll('[data-buy]').forEach(function(a){a.href='/cart/'+vid+':'+r.value})}
  root.querySelectorAll('.el-packs input').forEach(function(r){r.addEventListener('change',sync)});sync();
  var add=root.querySelector('[data-add]');
  var TXT=/cash on delivery|contra ?entrega|pag(a|ar|o) al recibir|pay on delivery|cod form/i,CLS=/(^|[\s_-])(rsi|releasit)/i;
  var ours=function(el){return el.closest('[data-buy],.el-sticky,.el-float,.el-pack,.el-add,.el-thumbs,.el-acc')};
  function meta(el){var c=el.className;c=(c&&c.baseVal!==undefined)?c.baseVal:(c||'');return c+' '+(el.id||'')}
  function scan(scope,useText){var list=scope.querySelectorAll('button,a,[role=button],input[type=submit]');
    for(var i=0;i<list.length;i++){var el=list[i];if(ours(el))continue;if(CLS.test(meta(el))||(el.parentElement&&CLS.test(meta(el.parentElement))))return el;
      if(useText&&TXT.test((el.innerText||el.value||'').trim()))return el}return null}
  function rsi(){return scan(root.querySelector('.el-info')||root,true)||scan(document,false)}
  function hide(b){var box=b,par=b.parentElement;if(par&&par.children.length===1&&!par.matches('form,.el-info,.el-form'))box=par;
    box.style.cssText+=';position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important;opacity:0!important;pointer-events:none!important';box.setAttribute('aria-hidden','true');b.tabIndex=-1}
  function adopt(){var b=rsi();if(!b)return false;hide(b);root.classList.add('has-rsi');return true}
  if(!adopt()&&'MutationObserver' in window){var mo=new MutationObserver(function(){if(adopt())mo.disconnect()});mo.observe(document.body,{childList:true,subtree:true});setTimeout(function(){mo.disconnect()},15000)}
  root.querySelectorAll('[data-buy]').forEach(function(a){a.addEventListener('click',function(e){var b=rsi();if(b){e.preventDefault();b.style.pointerEvents='auto';b.click()}})});
  var sticky=root.querySelector('[data-sticky]'),top=root.querySelector('[data-top]'),anchor=add||root.querySelector('[data-buy]');
  if('IntersectionObserver' in window){
    if(sticky&&anchor)new IntersectionObserver(function(e){var on=e[0].boundingClientRect.top<0&&!e[0].isIntersecting;sticky.classList.toggle('is-on',on);sticky.setAttribute('aria-hidden',String(!on));sticky.querySelector('a').tabIndex=on?0:-1;top.classList.toggle('is-on',on);top.tabIndex=on?0:-1}).observe(anchor);
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches){root.classList.add('js-rv');var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{rootMargin:'0px 0px -10% 0px'});root.querySelectorAll('.rv').forEach(function(el){io.observe(el)})}
  }
  top.addEventListener('click',function(){window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});var h=root.querySelector('h1,h2');if(h){h.tabIndex=-1;h.focus({preventScroll:true})}});
})();
</script>
</section>
{%- endif -%}

