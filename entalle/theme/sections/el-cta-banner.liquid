{%- liquid
  assign p = product
  if p == blank
    assign p = section.settings.product
  endif
  assign img = section.settings.image | default: p.featured_image
-%}
{%- if p != blank -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% endif %}" id="el-{{ section.id }}">
  <div class="el-container el-rv">
    <div class="el-banner">
      {%- if img != blank -%}{{ img | image_url: width: 520 | image_tag: widths: '260,520', sizes: '220px', loading: 'lazy', alt: p.title }}{%- endif -%}
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="el-eyebrow" style="color:var(--el-yellow)">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: p.title | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
        <p class="el-banner__price" style="margin-top:12px"><span data-el-now>{% render 'entalle-money', amount: p.price %}</span><s data-el-was hidden></s></p>
      </div>
      <div>
        {%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: section.settings.anim -%}
        {%- if section.settings.micro != blank -%}<div class="el-cta-micro" style="color:#d9d9de;margin-top:10px">{%- assign ms = section.settings.micro | split: '|' -%}{%- for m in ms -%}<span>{{ m | strip }}</span>{%- endfor -%}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Llamado de cierre","settings":[
{"type":"product","id":"product","label":"Producto (solo fuera de la página de producto)"},
{"type":"select","id":"bg","label":"Fondo de la sección","default":"white","options":[{"value":"white","label":"Blanco"},{"value":"soft","label":"Suave"}]},
{"type":"image_picker","id":"image","label":"Imagen (vacío = foto del producto)"},
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Oferta vigente"},
{"type":"text","id":"heading","label":"Título"},
{"type":"text","id":"text","label":"Texto"},
{"type":"text","id":"cta_label","label":"Botón","default":"PIDE AHORA"},
{"type":"text","id":"cta_sub","label":"Texto pequeño del botón","default":"Pagas al recibir"},
{"type":"select","id":"anim","label":"Animación","default":"pulse","options":[{"value":"pulse","label":"Pulso + destello"},{"value":"shake","label":"Vibración suave"},{"value":"shine","label":"Solo destello"},{"value":"none","label":"Sin animación"}]},
{"type":"text","id":"micro","label":"Microtexto (separado por |)","default":"🚚 Envío gratis | 💵 Pagas al recibir"}],
"presets":[{"name":"Llamado de cierre"}]}
{% endschema %}
