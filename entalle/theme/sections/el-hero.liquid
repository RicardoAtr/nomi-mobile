{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['catalogo']
  endif
  assign tiles = 0
-%}
<section class="el el-hero" id="el-{{ section.id }}">
  <div class="el-container">
    <div class="el-hero__grid">
      <div class="el-hero__copy">
        {%- if section.settings.eyebrow != blank -%}<span class="el-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h1>{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}<p class="el-hero__text">{{ section.settings.text | escape }}</p>{%- endif -%}
        <div class="el-hero__actions">
          {%- if section.settings.cta1_label != blank -%}<a class="el-btn el-anim-shine" data-el-anim href="{{ section.settings.cta1_url | default: col.url | default: routes.all_products_collection_url }}"><span class="el-btn__txt"><span>{{ section.settings.cta1_label | escape }}</span></span></a>{%- endif -%}
          {%- if section.settings.cta2_label != blank and section.settings.cta2_url != blank -%}<a class="el-btn el-btn--ghost el-btn--light" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label | escape }}</a>{%- endif -%}
        </div>
        {%- if section.settings.points != blank -%}<ul class="el-hero__points">{%- assign ps = section.settings.points | split: '|' -%}{%- for pt in ps -%}<li>{{ pt | strip }}</li>{%- endfor -%}</ul>{%- endif -%}
      </div>
      <div class="el-hero__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480,720,960,1200,1400', sizes: '(min-width: 990px) 560px, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading }}
        {%- elsif col != blank -%}
          <div class="el-hero__mosaic">
            {%- for it in col.products -%}
              {%- if it.available and it.featured_image and tiles < 4 -%}
                {%- assign tiles = tiles | plus: 1 -%}
                <a href="{{ it.url }}" class="el-hero__tile" aria-label="{{ it.title | escape }}">{{ it.featured_image | image_url: width: 700 | image_tag: widths: '350,700', sizes: '(min-width: 990px) 280px, 50vw', loading: 'eager', alt: '' }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
#el-{{ section.id }}{background:{{ section.settings.bg }};color:#fff}
.el-hero{padding:28px 0 36px}
@media(min-width:990px){.el-hero{padding:56px 0 64px}}
.el-hero__grid{display:grid;gap:24px;align-items:center}
@media(min-width:750px){.el-hero__grid{grid-template-columns:1.05fr 1fr;gap:40px}}
.el-hero h1{color:#fff;font-size:clamp(30px,6.4vw,54px);line-height:1.08}
.el-hero__eyebrow{display:inline-block;background:var(--el-yellow);color:var(--el-ink);font-weight:900;font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px;margin-bottom:14px}
.el-hero__text{color:#DCEBE1;font-size:17px;margin-top:12px;max-width:520px}
.el-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.el-hero__actions .el-btn{width:auto;min-width:200px}
.el-btn.el-btn.el-btn--light{color:#fff;border-color:rgba(255,255,255,.7)}
.el-btn.el-btn.el-btn--light:hover{--el-btn-bg:rgba(255,255,255,.1)}
.el-hero__points{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px 16px;font-size:14px;font-weight:700;color:#fff}
.el-hero__media img{width:100%;height:auto;border-radius:calc(var(--el-radius) + 4px)}
.el-hero__mosaic{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.el-hero__tile{display:block;border-radius:var(--el-radius);overflow:hidden;background:#fff;aspect-ratio:1/1}
.el-hero__tile:only-child{grid-column:1/-1;max-width:460px;justify-self:center;width:100%}
.el-hero__tile img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.el-hero__tile:hover img{transform:scale(1.03)}
@media(prefers-reduced-motion:reduce){.el-hero__tile img{transition:none}}
</style>
{% schema %}
{"name":"Portada de tienda","settings":[
{"type":"color","id":"bg","label":"Fondo","default":"#0F3D24"},
{"type":"text","id":"eyebrow","label":"Etiqueta","default":"Envío gratis a todo Chile"},
{"type":"text","id":"heading","label":"Título","default":"Productos útiles para tu día"},
{"type":"textarea","id":"text","label":"Texto"},
{"type":"text","id":"cta1_label","label":"Botón principal","default":"Ver catálogo"},
{"type":"url","id":"cta1_url","label":"Enlace del botón principal (vacío = Catálogo)"},
{"type":"text","id":"cta2_label","label":"Botón secundario"},
{"type":"url","id":"cta2_url","label":"Enlace del botón secundario"},
{"type":"text","id":"points","label":"Puntos (separados por |)","default":"🚚 Envío gratis | 💵 Pagas al recibir | 🛡️ Garantía 30 días"},
{"type":"image_picker","id":"image","label":"Imagen (vacío = mosaico del catálogo)"},
{"type":"collection","id":"collection","label":"Colección del mosaico (vacío = Catálogo)"}],
"presets":[{"name":"Portada de tienda"}]}
{% endschema %}
