{%- liquid
assign show = false
if section.blocks.size > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<ol class="el-steps" style="--cols:{{ section.blocks.size | at_most: 4 }}">{%- for b in section.blocks -%}<li {{ b.shopify_attributes }}>{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 600 | image_tag: widths: '300,600', sizes: '(min-width: 750px) 300px, 100vw', loading: 'lazy', alt: b.settings.title }}{%- endif -%}<h3>{{ b.settings.title | escape }}</h3>{%- if b.settings.text != blank -%}<p>{{ b.settings.text | escape }}</p>{%- endif -%}</li>{%- endfor -%}</ol>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Modo de uso",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "step",
   "name": "Paso",
   "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "Imagen"
    },
    {
     "type": "text",
     "id": "title",
     "label": "Título",
     "default": "Paso"
    },
    {
     "type": "textarea",
     "id": "text",
     "label": "Texto"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Modo de uso"
  }
 ]
}
{% endschema %}
