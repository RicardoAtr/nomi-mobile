{%- liquid
assign n = 0
for b in section.blocks
 if b.settings.verified and b.settings.text != blank
  assign n = n | plus: 1
 endif
endfor
assign show = false
if n > 0
 assign show = true
endif
-%}
{%- if show -%}
<section class="el el-section{% if section.settings.bg == 'soft' %} el-section--soft{% elsif section.settings.bg == 'dark' %} el-section--dark{% endif %}" id="el-{{ section.id }}"><div class="el-container el-rv">{%- render 'el-heading', s: section.settings -%}<div class="el-reviews">{%- for b in section.blocks -%}{%- if b.settings.verified and b.settings.text != blank -%}<article class="el-review" {{ b.shopify_attributes }}>{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Foto de la reseña' }}{%- endif -%}<div class="el-review__stars" aria-label="{{ b.settings.rating }} de 5">{%- for i in (1..b.settings.rating) -%}★{%- endfor -%}</div><p>{{ b.settings.text | escape }}</p><p class="el-review__meta"><b>{{ b.settings.name | escape }}</b>{% if b.settings.place != blank %} · {{ b.settings.place | escape }}{% endif %} · <span class="el-review__ok">✔ Compra verificada</span>{% if b.settings.date != blank %} · {{ b.settings.date | escape }}{% endif %}</p></article>{%- endif -%}{%- endfor -%}</div>{%- if section.settings.show_cta -%}<div style="max-width:440px;margin:28px auto 0">{%- render 'el-buy-button', label: section.settings.cta_label, sublabel: section.settings.cta_sub, anim: 'pulse' -%}</div>{%- endif -%}</div></section>
{%- endif -%}
{% schema %}
{
 "name": "Reseñas verificadas",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "white",
   "options": [
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "soft",
     "label": "Suave"
    },
    {
     "value": "dark",
     "label": "Oscuro"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título"
  },
  {
   "type": "textarea",
   "id": "intro",
   "label": "Bajada"
  },
  {
   "type": "paragraph",
   "content": "Solo se muestran reseñas marcadas como verificadas (pedido real comprobable). Si no hay ninguna, la sección no aparece."
  },
  {
   "type": "checkbox",
   "id": "show_cta",
   "label": "Mostrar botón de compra",
   "default": false
  },
  {
   "type": "text",
   "id": "cta_label",
   "label": "Texto del botón",
   "default": "PIDE AHORA"
  },
  {
   "type": "text",
   "id": "cta_sub",
   "label": "Texto pequeño del botón",
   "default": "Pagas al recibir"
  }
 ],
 "blocks": [
  {
   "type": "review",
   "name": "Reseña",
   "settings": [
    {
     "type": "checkbox",
     "id": "verified",
     "label": "Verificada con un pedido real",
     "default": false
    },
    {
     "type": "text",
     "id": "order_ref",
     "label": "N.º de pedido (interno, no se muestra)"
    },
    {
     "type": "range",
     "id": "rating",
     "label": "Estrellas",
     "min": 1,
     "max": 5,
     "step": 1,
     "default": 5
    },
    {
     "type": "textarea",
     "id": "text",
     "label": "Texto"
    },
    {
     "type": "text",
     "id": "name",
     "label": "Nombre"
    },
    {
     "type": "text",
     "id": "place",
     "label": "Comuna o ciudad"
    },
    {
     "type": "text",
     "id": "date",
     "label": "Fecha"
    },
    {
     "type": "image_picker",
     "id": "image",
     "label": "Foto del cliente (con permiso)"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Reseñas verificadas"
  }
 ]
}
{% endschema %}
