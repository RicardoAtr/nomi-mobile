<section class="ec wrap">
<style>
.ec{padding:32px 16px 48px;max-width:1180px;margin:0 auto}
.ec h1{margin:0 0 6px;font-size:clamp(26px,4vw,36px)}
.ec-intro{color:#4f5a53;margin:0 0 24px}
.ec-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));list-style:none;margin:0;padding:0}
.ec-card{border:1px solid #dfe5dc;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;background:var(--bg,#fff);transition:box-shadow .2s,transform .2s}
.ec-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.08);transform:translateY(-2px)}
.ec-img{position:relative;display:block;aspect-ratio:1/1;background:#f4f6f2}
.ec-img img{width:100%;height:100%;object-fit:cover;display:block}
.ec-badge{position:absolute;top:10px;left:10px;background:{{ section.settings.c_dark }};color:#fff;font-weight:800;font-size:13px;padding:4px 10px;border-radius:999px}
.ec-body{padding:14px;display:flex;flex-direction:column;gap:8px;flex:1}
.ec-body h2{font-size:17px;margin:0;line-height:1.3}
.ec-body h2 a{color:inherit;text-decoration:none}
.ec-price{font-weight:800;font-size:18px;margin:0}
.ec-btn{margin-top:auto;display:flex;align-items:center;justify-content:center;min-height:48px;border-radius:12px;background:{{ section.settings.c_dark }};color:#fff;font-weight:800;text-decoration:none}
.ec-btn:hover{background:#000}
.ec a:focus-visible{outline:3px solid {{ section.settings.c_dark }};outline-offset:3px}
.ec-empty{padding:32px;text-align:center;border:1px dashed #b9c4b3;border-radius:16px}
@media(prefers-reduced-motion:reduce){.ec-card{transition:none}.ec-card:hover{transform:none}}
</style>
<h1>{{ collection.title | escape }}</h1>
{%- if collection.description != blank -%}<div class="ec-intro rte">{{ collection.description }}</div>{%- endif -%}
{%- paginate collection.products by 24 -%}
{%- assign shown = 0 -%}
<ul class="ec-grid">
{%- for item in collection.products -%}
  {%- if item.available -%}
  {%- assign shown = shown | plus: 1 -%}
  <li class="ec-card">
    <a class="ec-img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.featured_image -%}{{ item.featured_image | image_url: width: 720 | image_tag: widths: '240,480,720', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}{%- endif -%}
      {%- if section.settings.badge_tag != blank and item.tags contains section.settings.badge_tag -%}<span class="ec-badge">{{ section.settings.badge_text | escape }}</span>{%- endif -%}
    </a>
    <div class="ec-body">
      <h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
      <p class="ec-price">{% if item.price_varies %}Desde {% endif %}{% render 'entalle-money', amount: item.price %}</p>
      <a class="ec-btn" href="{{ item.url }}">Ver producto</a>
    </div>
  </li>
  {%- endif -%}
{%- endfor -%}
</ul>
{%- if shown == 0 -%}<p class="ec-empty">Pronto sumaremos productos. Mientras, escríbenos si buscas algo.</p>{%- endif -%}
{%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
{%- endpaginate -%}
</section>
{% schema %}
{
 "name": "Catálogo",
 "settings": [
  {"type": "text", "id": "badge_tag", "label": "Etiqueta de producto que muestra el sello", "default": "2x1"},
  {"type": "text", "id": "badge_text", "label": "Texto del sello", "default": "2x1"},
  {"type": "color", "id": "c_dark", "label": "Color de botones", "default": "#1f5a14"}
 ]
}
{% endschema %}
