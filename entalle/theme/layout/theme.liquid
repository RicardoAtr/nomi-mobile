<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.el_primary }}">
{%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}"><link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">{%- else -%}<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23E5401C'/%3E%3Ctext x='32' y='45' font-family='Arial,sans-serif' font-size='38' font-weight='700' fill='%23fff' text-anchor='middle'%3E{{ settings.brand | slice: 0 | url_encode }}%3C/text%3E%3C/svg%3E">{%- endif -%}
<title>{{ page_title | escape }}{% if current_page != 1 %} · Página {{ current_page }}{% endif %}{% unless page_title contains settings.brand %} · {{ settings.brand | escape }}{% endunless %}</title>
{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:site_name" content="{{ settings.brand | escape }}"><meta property="og:locale" content="es_CL"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{%- assign og_img = page_image | default: settings.share_image -%}{% if page_description != blank %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}{% if og_img %}<meta property="og:image" content="https:{{ og_img | image_url: width: 1200 }}"><meta property="og:image:secure_url" content="https:{{ og_img | image_url: width: 1200 }}">{% endif %}
{% if request.page_type == 'product' %}<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}"><meta property="product:price:currency" content="{{ cart.currency.iso_code }}">{% endif %}<meta name="twitter:card" content="summary_large_image">
{{ content_for_header }}{% render 'entalle-styles' %}
{%- if settings.font_head -%}{{ settings.font_head | font_face: font_display: 'swap' }}{%- endif -%}{%- if settings.font_body -%}{{ settings.font_body | font_face: font_display: 'swap' }}{%- endif -%}
{{ 'el-core.css' | asset_url | stylesheet_tag }}
<script src="{{ 'el-core.js' | asset_url }}" defer></script>
{% style %}:root{--bg:{{ settings.background }};--ink:{{ settings.ink }};--accent:{{ settings.accent }};--surface:{{ settings.surface }};--el-primary:{{ settings.el_primary }};--el-primary-dark:{{ settings.el_primary_dark }};--el-ink:{{ settings.el_ink }};--el-soft:{{ settings.el_soft }};--el-yellow:{{ settings.el_yellow }};--el-trust:{{ settings.el_trust }};--el-font-head:{{ settings.font_head.family | default: 'Arial' }},{{ settings.font_head.fallback_families | default: 'sans-serif' }};--el-font-body:{{ settings.font_body.family | default: 'Arial' }},{{ settings.font_body.fallback_families | default: 'sans-serif' }}}body{font-family:var(--el-font-body)}{% endstyle %}
</head><body>
<a class="skip" href="#MainContent">{{ 'ui.skip' | t }}</a>
{% sections 'header-group' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}
{% section 'entalle-cart-drawer' %}{% render 'entalle-behavior' %}
<div class="sr-only" id="entalle-live" role="status" aria-live="polite"></div>
<script type="application/json" id="entalle-config">{"root":{{ routes.root_url | json }},"cart":{{ routes.cart_url | json }},"currency":{{ cart.currency.iso_code | json }},"locale":{{ request.locale.iso_code | json }},"messages":{"art":{{ 'ui.art' | t | json }},"skip":{{ 'ui.skip' | t | json }},"demo":{{ 'ui.demo' | t | json }},"pause":{{ 'ui.pause' | t | json }},"menu":{{ 'ui.menu' | t | json }},"mobile_nav":{{ 'ui.mobile_nav' | t | json }},"shop":{{ 'ui.shop' | t | json }},"navigation":{{ 'ui.navigation' | t | json }},"about":{{ 'ui.about' | t | json }},"search":{{ 'ui.search' | t | json }},"cart":{{ 'ui.cart' | t | json }},"close":{{ 'ui.close' | t | json }},"search_label":{{ 'ui.search_label' | t | json }},"help_links":{{ 'ui.help_links' | t | json }},"sold_out":{{ 'ui.sold_out' | t | json }},"from":{{ 'ui.from' | t | json }},"add":{{ 'ui.add' | t | json }},"options":{{ 'ui.options' | t | json }},"sample":{{ 'ui.sample' | t | json }},"sample_product":{{ 'ui.sample_product' | t | json }},"sample_only":{{ 'ui.sample_only' | t | json }},"view_all":{{ 'ui.view_all' | t | json }},"subscribed":{{ 'ui.subscribed' | t | json }},"email":{{ 'ui.email' | t | json }},"subscribe":{{ 'ui.subscribe' | t | json }},"consent":{{ 'ui.consent' | t | json }},"footer_links":{{ 'ui.footer_links' | t | json }},"payments":{{ 'ui.payments' | t | json }},"whatsapp":{{ 'ui.whatsapp' | t | json }},"whatsapp_message":{{ 'ui.whatsapp_message' | t | json }},"quantity":{{ 'ui.quantity' | t | json }},"discount_label":{{ 'ui.discount_label' | t | json }},"discount_final":{{ 'ui.discount_final' | t | json }},"breadcrumbs":{{ 'ui.breadcrumbs' | t | json }},"home":{{ 'ui.home' | t | json }},"zoom":{{ 'ui.zoom' | t | json }},"watch_video":{{ 'ui.watch_video' | t | json }},"previous":{{ 'ui.previous' | t | json }},"next":{{ 'ui.next' | t | json }},"reviews":{{ 'ui.reviews' | t | json }},"save":{{ 'ui.save' | t | json }},"taxes":{{ 'ui.taxes' | t | json }},"add_short":{{ 'ui.add_short' | t | json }},"shipping_info":{{ 'ui.shipping_info' | t | json }},"returns":{{ 'ui.returns' | t | json }},"description":{{ 'ui.description' | t | json }},"comparison":{{ 'ui.comparison' | t | json }},"criterion":{{ 'ui.criterion' | t | json }},"missing":{{ 'ui.missing' | t | json }},"free_shipping":{{ 'ui.free_shipping' | t | json }},"threshold_met":{{ 'ui.threshold_met' | t | json }},"shipping_progress":{{ 'ui.shipping_progress' | t | json }},"conditions":{{ 'ui.conditions' | t | json }},"empty_title":{{ 'ui.empty_title' | t | json }},"empty_text":{{ 'ui.empty_text' | t | json }},"explore":{{ 'ui.explore' | t | json }},"remove":{{ 'ui.remove' | t | json }},"update":{{ 'ui.update' | t | json }},"complete":{{ 'ui.complete' | t | json }},"discount_code":{{ 'ui.discount_code' | t | json }},"apply":{{ 'ui.apply' | t | json }},"subtotal":{{ 'ui.subtotal' | t | json }},"subtotal_after":{{ 'ui.subtotal_after' | t | json }},"shipping_checkout":{{ 'ui.shipping_checkout' | t | json }},"checkout":{{ 'ui.checkout' | t | json }},"continue":{{ 'ui.continue' | t | json }},"your_cart":{{ 'ui.your_cart' | t | json }},"filter":{{ 'ui.filter' | t | json }},"min_price":{{ 'ui.min_price' | t | json }},"max_price":{{ 'ui.max_price' | t | json }},"sort":{{ 'ui.sort' | t | json }},"clear":{{ 'ui.clear' | t | json }},"no_results":{{ 'ui.no_results' | t | json }},"contact_success":{{ 'ui.contact_success' | t | json }},"name":{{ 'ui.name' | t | json }},"order_optional":{{ 'ui.order_optional' | t | json }},"message":{{ 'ui.message' | t | json }},"send":{{ 'ui.send' | t | json }},"no_search":{{ 'ui.no_search' | t | json }},"not_found":{{ 'ui.not_found' | t | json }},"collections":{{ 'ui.collections' | t | json }},"password":{{ 'ui.password' | t | json }},"enter":{{ 'ui.enter' | t | json }},"gift":{{ 'ui.gift' | t | json }},"expired":{{ 'ui.expired' | t | json }},"contact_us":{{ 'ui.contact_us' | t | json }},"error":{{ 'ui.error' | t | json }},"cart_refresh":{{ 'ui.cart_refresh' | t | json }},"added_refresh_failed":{{ 'ui.added_refresh_failed' | t | json }},"removed":{{ 'ui.removed' | t | json }},"invalid_quantity":{{ 'ui.invalid_quantity' | t | json }},"adding":{{ 'ui.adding' | t | json }},"added":{{ 'ui.added' | t | json }},"updating":{{ 'ui.updating' | t | json }},"variant_error":{{ 'ui.variant_error' | t | json }},"discount_applied":{{ 'ui.discount_applied' | t | json }},"discount_check":{{ 'ui.discount_check' | t | json }},"per_unit":{{ 'ui.per_unit' | t | json }},"resume":{{ 'ui.resume' | t | json }},"search_fallback":{{ 'ui.search_fallback' | t | json }},"garment_art":{{ 'ui.garment_art' | t | json }},"occasion_art":{{ 'ui.occasion_art' | t | json }},"reference":{{ 'ui.reference' | t | json }},"choose_size":{{ 'ui.choose_size' | t | json }},"price_pending":{{ 'ui.price_pending' | t | json }},"size_table":{{ 'ui.size_table' | t | json }},"size":{{ 'ui.size' | t | json }},"waist":{{ 'ui.waist' | t | json }},"fit_note":{{ 'ui.fit_note' | t | json }},"measure_pending":{{ 'ui.measure_pending' | t | json }},"size_unverified":{{ 'ui.size_unverified' | t | json }},"measure_one":{{ 'ui.measure_one' | t | json }},"measure_two":{{ 'ui.measure_two' | t | json }},"measure_three":{{ 'ui.measure_three' | t | json }},"video_editor":{{ 'ui.video_editor' | t | json }},"purchase_unavailable":{{ 'ui.purchase_unavailable' | t | json }},"size_help":{{ 'ui.size_help' | t | json }},"thermal_heading":{{ 'ui.thermal_heading' | t | json }},"thermal_text":{{ 'ui.thermal_text' | t | json }},"stock_check":{{ 'ui.stock_check' | t | json }},"stock_unavailable":{{ 'ui.stock_unavailable' | t | json }},"stock_failed":{{ 'ui.stock_failed' | t | json }}}}</script>
</body></html>
