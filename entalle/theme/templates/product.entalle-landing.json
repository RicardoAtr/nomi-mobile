    "b1": {
     "type": "q",
     "settings": {
      "q": "¿Cuánto demora en llegar?",
      "a": "<p>Tu pedido llega entre 2 y 6 días después de la compra. Arriba del botón de compra ves las fechas estimadas según el día en que compras.</p>"
     }
    },
    "b2": {
     "type": "q",
     "settings": {
      "q": "¿El envío tiene costo?",
      "a": "<p>No. El envío es gratis en todos los pedidos.</p>"
