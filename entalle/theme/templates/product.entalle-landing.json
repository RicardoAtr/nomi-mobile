    },
    "b4": {
     "type": "q",
     "settings": {
      "q": "¿Tiene alcohol o gluten?",
      "a": "<p>No. Es una fórmula sin alcohol, sin gluten y apta para veganos.</p>"
     }
    },
    "b5": {
     "type": "q",
     "settings": {
      "q": "¿Puedo tomarlo si estoy embarazada o tomo medicamentos?",
      "a": "<p>Si estás embarazada, amamantando o en tratamiento médico, consulta a tu médico antes de consumirlo.</p>"
