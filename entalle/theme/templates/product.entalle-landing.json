    },
    "b3": {
     "type": "q",
     "settings": {
      "q": "¿Cómo se consume?",
      "a": "<p>Agrega 15 gotas a un vaso de agua, mezcla y disfruta. Sigue siempre las indicaciones de la etiqueta.</p>"
