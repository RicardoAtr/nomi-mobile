     }
    },
    "b4": {
     "type": "q",
     "settings": {
      "q": "¿Para quién no es?",
      "a": "<p>No es para menores de 18 años. Si consumes medicamentos, estás embarazada, en período de lactancia o tienes alguna condición de salud, consulta a un profesional de la salud antes de consumirlo.</p>"
     }
    },
    "b5": {
     "type": "q",
     "settings": {
      "q": "¿Es un medicamento?",
      "a": "<p>No. Es un suplemento alimenticio: no está destinado a diagnosticar, tratar, curar ni prevenir enfermedades, y no reemplaza tratamientos indicados por profesionales de la salud.</p>"
