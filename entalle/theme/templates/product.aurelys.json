     "settings": {
      "q": "¿Qué es Aurelys?",
      "a": "<p>Un suplemento alimenticio de extractos líquidos de plantas, en frasco de 50 ml con gotario.</p>"
     }
    },
    "b1": {
     "type": "q",
     "settings": {
      "q": "¿Cómo se usa?",
      "a": "<p>Agita el frasco, mide con el gotario la cantidad que indica la etiqueta y tómalo en agua o en té, idealmente siempre en el mismo momento del día.</p>"
     }
    },
    "b2": {
     "type": "q",
     "settings": {
      "q": "¿Para quién no es Aurelys?",
      "a": "<p>No es un producto para bajar de peso. Si estás embarazada, amamantando, tomas medicamentos o tienes alguna condición de salud, consulta primero a tu médico. No es para menores de 18 años.</p>"
     }
    },
    "b3": {
     "type": "q",
     "settings": {
      "q": "¿Sirve para bajar de peso?",
      "a": "<p>No. Es un suplemento alimenticio. No reemplaza una alimentación equilibrada ni un tratamiento médico.</p>"
     }
    },
    "b4": {
     "type": "q",
     "settings": {
      "q": "¿Cómo pago y cuánto demora el envío?",
      "a": "<p>Pagas al recibir tu pedido, sin adelantar dinero. El envío es gratis a todo Chile y llega entre 2 y 6 días.</p>"
     }
    },
    "b5": {
     "type": "q",
     "settings": {
      "q": "¿Qué pasa si tengo un problema con mi pedido?",
      "a": "<p>Tienes 30 días de garantía. Escríbenos por WhatsApp al +56 9 4058 9575 o a <a href=\"mailto:contacto@entalle.cl\">contacto@entalle.cl</a> y lo resolvemos.</p>"
     }
    }
