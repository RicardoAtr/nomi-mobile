{% doc %}
entalle-cart-content
@param {string} context - Unique form scope
{% enddoc %}
{% if cart.item_count == 0 %}<div class="empty-cart"><h2>{{ 'ui.empty_title' | t }}</h2><p>{{ 'ui.empty_text' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'ui.explore' | t }}</a></div>{% else %}{% render 'entalle-shipping' %}<form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ context }}" data-cart-form><div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 90 }}</a>{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign initial = property.first | slice: 0 %}{% if property.last != blank and initial != '_' %}<p class="quiet">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}<p>{% if item.original_line_price > item.final_line_price %}<s>{% render 'entalle-money', amount: item.original_line_price %}</s> {% endif %}<strong>{% render 'entalle-money', amount: item.final_line_price %}</strong></p>{% for allocation in item.line_level_discount_allocations %}<p class="quiet">{{ allocation.discount_application.title | escape }}</p>{% endfor %}<div class="cart-quantity"><label class="sr-only" for="CartQty-{{ context }}-{{ forloop.index }}">{{ 'ui.quantity' | t }} {{ item.product.title | escape }}</label><input id="CartQty-{{ context }}-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" data-line-key="{{ item.key }}"><a href="{{ item.url_to_remove }}" data-remove-key="{{ item.key }}">{{ 'ui.remove' | t }}</a></div></div></article>{% endfor %}</div><noscript><button type="submit" name="update">{{ 'ui.update' | t }}</button></noscript></form>
{% assign upsell = settings.cart_upsell %}{% assign already = false %}{% for item in cart.items %}{% if item.product.id == upsell.id %}{% assign already = true %}{% endif %}{% endfor %}{% if upsell and upsell.available and already == false %}<div class="cart-upsell"><h3>{{ 'ui.complete' | t }}</h3>{% render 'entalle-card', card_product: upsell %}</div>{% endif %}
<form data-discount-form class="discount-form"><label for="Discount-{{ context }}">{{ 'ui.discount_code' | t }}</label><div class="inline-form"><input id="Discount-{{ context }}" name="discount" autocomplete="off"><button type="submit">{{ 'ui.apply' | t }}</button></div></form>
{%- assign solo_digital = true -%}{%- for item in cart.items -%}{%- if item.requires_shipping -%}{%- assign solo_digital = false -%}{%- endif -%}{%- endfor -%}
<div class="cart-summary"><div><span>{{ 'ui.subtotal' | t }}</span><span>{% render 'entalle-money', amount: cart.items_subtotal_price %}</span></div>{% for discount in cart.cart_level_discount_applications %}<div><span>{{ discount.title | escape }}</span><span>−{% render 'entalle-money', amount: discount.total_allocated_amount %}</span></div>{% endfor %}<div class="summary-total"><strong>{{ 'ui.subtotal_after' | t }}</strong><strong>{% render 'entalle-money', amount: cart.total_price %}</strong></div><p class="quiet">{% if solo_digital %}Guías digitales: recibes el enlace de descarga en tu correo.{% else %}Envío gratis a todo Chile.{% endif %} {% if cart.taxes_included %}{{ 'ui.taxes' | t }}{% endif %}</p><button class="button full" form="CartForm-{{ context }}" name="checkout" type="submit">Pagar ahora con Mercado Pago →</button>{% unless solo_digital %}<p class="quiet" style="text-align:center;margin-top:6px">¿Prefieres pagar al recibir? Usa el botón de pago contra entrega.</p>{% endunless %}<a class="continue" href="{{ routes.all_products_collection_url }}">{{ 'ui.continue' | t }}</a>{% if settings.payments %}<ul class="payment-icons" aria-label="{{ 'ui.payments' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}</div>{% endif %}<p class="cart-status" role="status" aria-live="polite"></p>
